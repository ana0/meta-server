# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=8080
BASE_PATH=

# --- Postgres ----------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# DATABASE_DIALECT=postgres

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://:redis@localhost:6379

# --- Tracking app (added for the cycle/energy tracker) ----------------------
TRACKING_PASSWORD=
# Frontend origin: CORS + post-Oura-connect redirect target (e.g. http://localhost:5173)
TRACKING_ORIGIN=
# Oura OAuth2 app credentials (developer.ouraring.com). Redirect URI must match
# a URI registered on the Oura app, e.g. https://<backend>/api/entries/oura/callback
TRACKING_OURA_CLIENT_ID=
TRACKING_OURA_CLIENT_SECRET=
TRACKING_OURA_REDIRECT_URI=

# --- Worker ------------------------------------------------------------------
# WORKER=true

# --- Chain RPCs --------------------------------------------------------------
POLYGON_NODE=
POLYGON_NODE_WS=
ETHEREUM_NODE=
ETHEREUM_NODE_WS=

# --- Controller private keys (signer wallets) --------------------------------
OFF_CONTROLLER=
WILDCARDS_CONTROLLER=
MIRROR_CONTROLLER=
MEMORYFORMS_CONTROLLER=
CHARON_CONTROLLER=
GRAVEDIGGER_PRIV_KEY=

# --- Contract addresses ------------------------------------------------------
OFF_CONTRACT=
LIFEFORMS_CONTRACT=
WILDCARDS_CONTRACT=
MIRROR_CONTRACT=
MEMORYFORMS_CONTRACT=
CHARON_CONTRACT=
